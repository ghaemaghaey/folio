# Copy to .env on the Calibre machine and edit.
#   cp .env.example .env

# Required: long random string for JWT signing
JWT_SECRET=replace-with-a-long-random-secret

# Required: host path (or Docker volume) of the Calibre library
# Examples:
#   CALIBRE_LIBRARY_HOST_PATH=/opt/calibre-web/library
#   CALIBRE_LIBRARY_HOST_PATH=/books
#   CALIBRE_LIBRARY_HOST_PATH=calibre_library   # named docker volume
CALIBRE_LIBRARY_HOST_PATH=/path/to/Calibre Library

# Optional: published port on the host
FOLIO_SERVER_PORT=8090

# Optional: override image (default matches GitHub owner)
# FOLIO_SERVER_IMAGE=ghcr.io/ghaemaghaey/folio-server:latest
